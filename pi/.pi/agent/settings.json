{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "theme": "catppuccin-latte/catppuccin-macchiato",
  "packages": [
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-tmux-focus-cursor",
    "npm:@haphazarddev/pi-vim-quit",
    "npm:@haphazarddev/pi-ask-user-question",
    "npm:@haphazarddev/pi-copy-code-block",
    "npm:@haphazarddev/pi-interactive-code-review",
    "npm:@haphazarddev/pi-background-bash",
    "npm:@gotgenes/pi-permission-system"
  ],
  "lastChangelogVersion": "1.1.0",
  "subagents": {
    "defaultThinking": "medium",
    "agentOverrides": {
      "scout": {
        "thinking": "low"
      },
      "worker": {
        "thinking": "high"
      },
      "reviewer": {
        "thinking": "high"
      },
      "planner": {
        "thinking": "high"
      },
      "oracle": {
        "thinking": "high"
      },
      "advisor": {
        "thinking": "high"
      }
    }
  }
}