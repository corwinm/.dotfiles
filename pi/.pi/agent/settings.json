  "defaultThinkingLevel": "medium",
  "hideThinkingBlock": false,
  "packages": [
    "npm:@sherif-fanous/pi-catppuccin",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-tmux-focus-cursor",
    "npm:@haphazarddev/pi-vim-quit",
    "npm:@haphazarddev/pi-ask-user-question",
    "npm:@haphazarddev/pi-copy-code-block",
    "npm:@haphazarddev/pi-interactive-code-review",
    "npm:@haphazarddev/pi-background-bash",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-system-theme"
  ],
  "theme": "catppuccin-latte",
  "lastChangelogVersion": "0.85.1",
