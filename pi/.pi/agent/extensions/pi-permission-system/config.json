{
  "permission": {
    "*": "allow",
    "bash": {
      "rm -rf *": "deny",
      "sudo *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow",
      "/private/var/folders/*": "allow"
    }
  },
  "shellTools": {
    "background_bash_start": {
      "commandArgument": "command",
      "workdirArgument": "cwd"
    }
  }
}
