#!/usr/bin/env bash

# Inspired by CriticalElement/dotfiles, adapted from yabai Spaces to
# AeroSpace workspaces. Select matching Catppuccin colors for the current
# macOS appearance each time SketchyBar loads.
if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -q '^Dark$'; then
  BLUE=0xff1e6e77
  ORANGE=0xffcc7b6e
  PINK=0xffd7448a
  RED=0xffce3a5b
  GREEN=0xff638989
  PURPLE=0xff8c6bc8
  CREAM=0xffd3cdc5
  TEXT=0xffffffff
  MUTED=0xffa5adcb
  PILL=0xd91e1e2e
  POPUP=0xff1e1e2e
  # Match JankyBorders' unfocused-window outline.
  BORDER=0xff45475a
else
  BLUE=0xff1e66f5
  ORANGE=0xfffe640b
  PINK=0xffea76cb
  RED=0xffd20f39
  GREEN=0xff40a02b
  PURPLE=0xff8839ef
  CREAM=0xff5c5f77
  TEXT=0xff4c4f69
  MUTED=0xff8c8fa1
  PILL=0xd9eff1f5
  POPUP=0xffeff1f5
  # Match JankyBorders' unfocused-window outline.
  BORDER=0xffacb0be
fi
APPLE_COLOR="$MUTED"
WHITE="$TEXT"
TRANSPARENT=0x00000000
FONT="Liga SFMono Nerd Font"

# Leave the wallpaper visible between independent status capsules. The 5px
# margin is AeroSpace's 8px outer gap minus half of JankyBorders' 6px stroke,
# aligning the capsules with the visible outside edge of the border.
sketchybar --bar \
  drawing=on \
  display=all \
  height=44 \
  margin=5 \
  y_offset=0 \
  notch_width=200 \
  padding_left=0 \
  padding_right=0 \
  color="$TRANSPARENT" \
  shadow=off \
  sticky=on \
  topmost=window

sketchybar --default \
  updates=when_shown \
  icon.font="$FONT:Normal:13.0" \
  icon.color="$MUTED" \
  label.font="$FONT:Normal:13.0" \
  label.color="$WHITE" \
  background.color="$PILL" \
  background.corner_radius=16 \
  background.height=32 \
  background.border_width=1 \
  background.border_color="$BORDER" \
  icon.padding_left=10 \
  icon.padding_right=4 \
  label.padding_left=4 \
  label.padding_right=10

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_mode_change
sketchybar --add event aerospace_cheatsheet
sketchybar --add event coding_agents_changed
sketchybar --add event system_appearance_changed AppleInterfaceThemeChangedNotification
sketchybar --add event screen_unlocked com.apple.screenIsUnlocked

# Recover the bar window after sleep or unlocking from the screen saver.
sketchybar --add item wake_watcher left \
  --subscribe wake_watcher system_woke screen_unlocked \
  --set wake_watcher \
    drawing=off \
    updates=on \
    script="$CONFIG_DIR/plugins/wake.sh"

sketchybar --add item appearance_watcher left \
  --subscribe appearance_watcher system_appearance_changed \
  --set appearance_watcher \
    drawing=off \
    updates=on \
    script="$CONFIG_DIR/plugins/appearance.sh"
# A compact Apple menu keeps occasional system actions off the persistent bar.
sketchybar --add item apple_menu left \
  --set apple_menu \
    padding_left=2 \
    padding_right=2 \
    icon="" \
    icon.font="$FONT:Normal:18.0" \
    icon.color="$APPLE_COLOR" \
    icon.padding_left=8 \
    icon.padding_right=8 \
    label.drawing=off \
    background.drawing=off \
    popup.align=left \
    popup.height=28 \
    popup.background.color="$POPUP" \
    popup.background.corner_radius=10 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
    click_script="$CONFIG_DIR/plugins/apple_menu.sh toggle"

apple_menu_items=(about settings activity lock)
apple_menu_icons=("󰋼" "" "󰄪" "")
apple_menu_labels=("About This Mac" "System Settings" "Activity Monitor" "Lock Screen")
for i in "${!apple_menu_items[@]}"; do
  action="${apple_menu_items[$i]}"
  sketchybar --add item "apple.$action" popup.apple_menu \
    --set "apple.$action" \
      icon="${apple_menu_icons[$i]}" \
      icon.color="$PINK" \
      icon.width=24 \
      icon.align=center \
      icon.padding_left=8 \
      icon.padding_right=4 \
      label="${apple_menu_labels[$i]}" \
      label.color="$TEXT" \
      label.width=150 \
      label.align=left \
      label.padding_left=4 \
      label.padding_right=10 \
      background.drawing=off \
      click_script="$CONFIG_DIR/plugins/apple_menu.sh $action"
done
sketchybar --subscribe apple.about mouse.exited.global

# Show only populated workspaces (plus the focused workspace when empty).
# A divider separates personal workspaces 1–5 from work workspaces 6–9.
workspace_items=(aerospace_mode)

# Keep one fixed-width mode slot before the workspace numbers. A colored dot is
# the normal state; robot and window icons indicate the temporary modes.
sketchybar --add item aerospace_mode left \
  --subscribe aerospace_mode aerospace_mode_change \
  --set aerospace_mode \
    width=dynamic \
    padding_left=4 \
    padding_right=0 \
    updates=on \
    icon="●" \
    icon.color="$GREEN" \
    icon.align=center \
    icon.width=26 \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.drawing=off \
    background.drawing=off \
    popup.align=left \
    popup.height=28 \
    popup.background.color="$POPUP" \
    popup.background.corner_radius=10 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
    update_freq=2 \
    script="$CONFIG_DIR/plugins/aerospace_mode.sh" \
    click_script="$CONFIG_DIR/plugins/aerospace_cheatsheet.sh"

# Hidden rows for the mode-aware Hyper+? cheatsheet. The script enables only
# the rows relevant to the currently active AeroSpace mode.
for i in $(seq 1 18); do
  sketchybar --add item "aerospace_cheatsheet.$i" popup.aerospace_mode \
    --set "aerospace_cheatsheet.$i" \
      drawing=off \
      icon.color="$BLUE" \
      icon.width=92 \
      icon.align=left \
      icon.padding_left=10 \
      icon.padding_right=8 \
      label.color="$TEXT" \
      label.width=220 \
      label.align=left \
      label.padding_left=0 \
      label.padding_right=12 \
      background.drawing=off
done

# The first popup row receives SketchyBar's global mouse-exit event, matching
# the dismissal behavior of the other native popups.
sketchybar --set aerospace_cheatsheet.1 script="$CONFIG_DIR/plugins/aerospace_cheatsheet.sh"
sketchybar --subscribe aerospace_cheatsheet.1 mouse.exited.global

sketchybar --add item aerospace_cheatsheet_watcher left \
  --subscribe aerospace_cheatsheet_watcher aerospace_cheatsheet \
  --set aerospace_cheatsheet_watcher \
    drawing=off \
    updates=on \
    script="$CONFIG_DIR/plugins/aerospace_cheatsheet.sh"

sketchybar --subscribe aerospace_mode aerospace_mode_change

for sid in $(aerospace list-workspaces --all); do
  if [[ "$sid" == "6" ]]; then
    workspace_items+=(workspace_separator)
    sketchybar --add item workspace_separator left \
      --set workspace_separator \
        width=1 \
        icon.drawing=off \
        label.drawing=off \
        background.color="$CREAM" \
        background.height=18 \
        background.corner_radius=0 \
        background.border_width=0 \
        background.drawing=on
  fi

  item="space.$sid"
  workspace_items+=("$item")
  sketchybar --add item "$item" left \
    --set "$item" \
      drawing=off \
      padding_left=2 \
      padding_right=2 \
      icon="$sid" \
      icon.drawing=on \
      icon.font="$FONT:Normal:14.0" \
      icon.align=center \
      icon.width=26 \
      icon.padding_left=0 \
      icon.padding_right=0 \
      label.drawing=off \
      background.color="$BLUE" \
      background.height=22 \
      background.corner_radius=11 \
      background.border_width=0 \
      background.drawing=off \
      popup.align=left \
      popup.height=28 \
      popup.background.color="$POPUP" \
      popup.background.corner_radius=10 \
      popup.background.border_width=1 \
      popup.background.border_color="$BORDER" \
      click_script="$CONFIG_DIR/plugins/workspace_menu.sh menu $sid"

  for row in $(seq 1 20); do
    sketchybar --add item "workspace_menu.$sid.$row" popup."space.$sid" \
      --set "workspace_menu.$sid.$row" \
        drawing=off \
        icon.color="$BLUE" \
        icon.width=22 \
        icon.padding_left=10 \
        icon.padding_right=6 \
        label.color="$TEXT" \
        label.width=360 \
        label.align=left \
        label.padding_left=0 \
        label.padding_right=12 \
        background.drawing=off
  done
  sketchybar --set "workspace_menu.$sid.1" script="$CONFIG_DIR/plugins/workspace_menu.sh"
  sketchybar --subscribe "workspace_menu.$sid.1" mouse.exited.global
done

# A single hidden watcher updates all workspace items in one pass.
sketchybar --add item workspace_watcher left \
  --subscribe workspace_watcher aerospace_workspace_change \
  --set workspace_watcher \
    drawing=off \
    updates=on \
    update_freq=2 \
    script="$CONFIG_DIR/plugins/aerospace.sh"

# Keep the fixed workspace strip first so app-name width changes cannot move it.
sketchybar --add item front_app left \
  --subscribe front_app front_app_switched \
  --set front_app \
    padding_left=2 \
    padding_right=2 \
    icon="󰀻" \
    icon.drawing=on \
    icon.color="$MUTED" \
    icon.padding_left=12 \
    icon.padding_right=6 \
    label.max_chars=38 \
    label.padding_left=0 \
    label.padding_right=12 \
    background.drawing=off \
    popup.align=left \
    popup.height=28 \
    popup.background.color="$POPUP" \
    popup.background.corner_radius=10 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
    click_script="$CONFIG_DIR/plugins/front_app_menu.sh toggle" \
    script="$CONFIG_DIR/plugins/front_app.sh"

front_app_actions=(new settings hide quit)
front_app_icons=("󰐕" "" "󰖰" "󰅖")
front_app_labels=("New Window    ⌘N" "Settings      ⌘," "Hide          ⌘H" "Quit          ⌘Q")
for i in "${!front_app_actions[@]}"; do
  action="${front_app_actions[$i]}"
  sketchybar --add item "front-app.$action" popup.front_app \
    --set "front-app.$action" \
      icon="${front_app_icons[$i]}" \
      icon.color="$CREAM" \
      icon.width=24 \
      icon.align=center \
      icon.padding_left=8 \
      icon.padding_right=4 \
      label="${front_app_labels[$i]}" \
      label.color="$TEXT" \
      label.width=165 \
      label.align=left \
      label.padding_left=4 \
      label.padding_right=10 \
      background.drawing=off \
      click_script="$CONFIG_DIR/plugins/front_app_menu.sh $action"
done
sketchybar --subscribe front-app.new mouse.exited.global

# Apple controls, workspace state, and application context share a single
# surface, matching the consolidated system capsule on the right.
left_items=(apple_menu "${workspace_items[@]}" front_app)
sketchybar --add bracket left_status "${left_items[@]}" \
  --set left_status \
    background.color="$PILL" \
    background.corner_radius=12 \
    background.height=32 \
    background.border_width=3 \
    background.border_color="$BORDER" \
    background.shadow.drawing=off \
    background.drawing=on

# Quiet, monochrome status controls share one floating capsule. Accent colors
# are reserved for transient state such as agent activity and warnings.
# Right-side items are declared from the outside inward.
sketchybar --add item time right \
  --set time \
    padding_left=2 \
    padding_right=2 \
    icon="󱑎" \
    icon.color="$MUTED" \
    background.drawing=off \
    update_freq=10 \
    click_script="$CONFIG_DIR/plugins/notification_center.sh" \
    script="$CONFIG_DIR/plugins/clock.sh"

sketchybar --add item date right \
  --set date \
    padding_left=2 \
    padding_right=2 \
    icon="󱨰" \
    icon.color="$MUTED" \
    background.drawing=off \
    popup.align=right \
    popup.height=22 \
    popup.background.color="$POPUP" \
    popup.background.corner_radius=10 \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER" \
    update_freq=30 \
    click_script="$CONFIG_DIR/plugins/calendar.sh toggle" \
    script="$CONFIG_DIR/plugins/date.sh"

for row in {0..7}; do
  sketchybar --add item "calendar.$row" popup.date \
    --set "calendar.$row" \
      width=178 \
      icon.drawing=off \
      label.font="$FONT:Normal:13.0" \
      label.width=160 \
      label.align=left \
      label.padding_left=9 \
      label.padding_right=9 \
      background.drawing=off \
      script="$CONFIG_DIR/plugins/calendar.sh" \
    --subscribe "calendar.$row" mouse.scrolled
done

# Dismiss the popup after the pointer leaves the calendar or bar.
sketchybar --subscribe calendar.0 mouse.exited.global

sketchybar --add item volume right \
  --subscribe volume volume_change mouse.clicked mouse.scrolled \
  --set volume \
    padding_left=2 \
    padding_right=2 \
    icon="󰕾" \
    icon.color="$MUTED" \
    background.drawing=off \
    script="$CONFIG_DIR/plugins/volume.sh"

sketchybar --add item battery right \
  --subscribe battery power_source_change system_woke \
  --set battery \
    padding_left=2 \
    padding_right=2 \
    icon="" \
    icon.color="$MUTED" \
    background.drawing=off \
    update_freq=20 \
    click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'" \
    script="$CONFIG_DIR/plugins/battery.sh"

# This pill appears only while Time Machine is actively backing up.
sketchybar --add item time_machine right \
  --set time_machine \
    drawing=off \
    updates=on \
    padding_left=2 \
    padding_right=2 \
    icon="󰁯" \
    icon.color="$BLUE" \
    background.drawing=off \
    update_freq=15 \
    click_script="$CONFIG_DIR/plugins/time_machine.sh" \
    script="$CONFIG_DIR/plugins/time_machine.sh"

# Warn only when neither Wi-Fi nor a physical Ethernet interface is active.
sketchybar --add item network_offline right \
  --subscribe network_offline system_woke wifi_change \
  --set network_offline \
    drawing=off \
    updates=on \
    padding_left=2 \
    padding_right=2 \
    icon="󰤭" \
    icon.color="$ORANGE" \
    label="Offline" \
    background.drawing=off \
    update_freq=10 \
    click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'" \
    script="$CONFIG_DIR/plugins/network.sh"

# Native CoreAudio/CoreMediaIO checks drive conditional privacy pills.
sketchybar --add item camera_active right \
  --set camera_active \
    drawing=off \
    padding_left=2 \
    padding_right=2 \
    icon="󰄀" \
    icon.color="$GREEN" \
    label="Camera" \
    background.drawing=off

sketchybar --add item microphone_active right \
  --set microphone_active \
    drawing=off \
    padding_left=2 \
    padding_right=2 \
    icon="󰍬" \
    icon.color="$ORANGE" \
    label="Mic" \
    background.drawing=off

sketchybar --add item privacy_watcher right \
  --set privacy_watcher \
    drawing=off \
    updates=on \
    update_freq=2 \
    script="$CONFIG_DIR/plugins/privacy.sh"

# Agent state is event-driven by coding-agents-tmux. The popup expands the
# compact glyph summary into indexed project rows with direct switching.
sketchybar --add item coding-agents right \
  --subscribe coding-agents coding_agents_changed \
  --set coding-agents \
    padding_left=2 \
    padding_right=2 \
    icon.drawing=off \
    icon.padding_left=10 \
    icon.padding_right=6 \
    label.padding_right=10 \
    background.drawing=off \
    popup.align=right \
    popup.height=28 \
    popup.background.color="$POPUP" \
    popup.background.corner_radius=10 \
    popup.background.border_width=1 \
    popup.background.border_color="$BLUE" \
    updates=on \
    click_script="$CONFIG_DIR/plugins/agent_menu.sh toggle" \
    script="$CONFIG_DIR/plugins/coding_agents.sh"

for index in {1..9}; do
  sketchybar --add item "coding-agent.$index" popup.coding-agents \
    --set "coding-agent.$index" \
      drawing=off \
      icon="$index" \
      icon.width=24 \
      icon.align=center \
      icon.padding_left=8 \
      icon.padding_right=4 \
      label.width=210 \
      label.align=left \
      label.padding_left=4 \
      label.padding_right=10 \
      background.drawing=off \
      click_script="$CONFIG_DIR/plugins/agent_menu.sh switch $index"
done

sketchybar --add item coding-agent.chooser popup.coding-agents \
  --set coding-agent.chooser \
    icon="󰍉" \
    icon.color="$CREAM" \
    icon.width=24 \
    icon.align=center \
    icon.padding_left=8 \
    icon.padding_right=4 \
    label="Open full chooser…" \
    label.color="$TEXT" \
    label.width=210 \
    label.align=left \
    label.padding_left=4 \
    label.padding_right=10 \
    background.drawing=off \
    click_script="$CONFIG_DIR/plugins/agent_menu.sh chooser"
sketchybar --subscribe coding-agent.1 mouse.exited.global

# One neutral surface keeps persistent system information visually quiet while
# still allowing conditional items to appear and disappear inside the group.
status_items=(
  coding-agents microphone_active camera_active network_offline time_machine
  battery volume date time
)
sketchybar --add bracket system_status "${status_items[@]}" \
  --set system_status \
    background.color="$PILL" \
    background.corner_radius=12 \
    background.height=32 \
    background.border_width=3 \
    background.border_color="$BORDER" \
    background.shadow.drawing=off \
    background.drawing=on

focused_workspace="$(aerospace list-workspaces --focused)"
current_mode="$(aerospace list-modes --current)"
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE="$focused_workspace"
sketchybar --trigger aerospace_mode_change MODE="$current_mode"
NAME=coding-agents "$CONFIG_DIR/plugins/coding_agents.sh"
sketchybar --hotload on
sketchybar --update
